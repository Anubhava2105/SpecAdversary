OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=your_key_here
# Main tier: critique and synthesis. Fast tier (optional): parsing/moderation.
OPENAI_MODEL=google/gemini-2.5-flash-lite
OPENAI_MODEL_FAST=
# Per-run model tiering: guest runs stay on the cheap tier, paid runs use
# the mid-tier model for critique/synthesis. Each falls back when unset
# (guest -> fast tier, paid -> main tier).
OPENAI_MODEL_GUEST=
OPENAI_MODEL_PAID=
# Max cumulative LLM tokens per analysis run (financial-DoS wall).
RUN_TOKEN_BUDGET=150000

DATABASE_URL=postgresql://specadv:specadv@db:5432/specadv
# Production PostgreSQL pool tuning (server-side databases only; ignored for SQLite).
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
# Redis credentials are required in Docker deployments (compose enforces it).
# Local no-docker development can use redis://localhost:6379/0 without a password.
REDIS_PASSWORD=change-me-to-a-long-random-password
REDIS_URL=redis://:change-me-to-a-long-random-password@redis:6379/0
RATELIMIT_STORAGE_URI=memory://
# Set only for local development when no worker service is running.
INLINE_WORKER=false
TAVILY_API_KEY=your_tavily_key_here

# Auth
JWT_SECRET=change-me-to-a-64-char-random-secret
FRONTEND_URL=http://localhost:5174
# Set ENV=production in deployment; enables strict startup validation and HSTS.
ENV=development

# Rate limiting
# Trust X-Forwarded-For for client IPs (set true only behind your own reverse proxy).
TRUST_PROXY=false
# Shared limiter storage (Redis keeps counters across restarts/replicas).
RATELIMIT_STORAGE_URI=memory://
# Per-user daily analysis allowance for authenticated users.
PER_USER_DAILY_SESSION_LIMIT=25
# Local development only: DEV_NO_LIMITS=true disables rate limiting and daily
# session budgets so the platform can be tested freely in guest and signed-in
# sessions. Refused in production at startup. Never enable outside dev.
DEV_NO_LIMITS=false

# Worker concurrency (ARQ in-process jobs; keep small — sync DB sessions
# block the event loop. Scale with worker replicas, not this number).
WORKER_CONCURRENCY=2

# Error tracking (optional — leave blank to disable; no-op when unset)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Release tag reported to Sentry (CI stamps the git SHA here).
GIT_SHA=dev

# Transactional email (verification + password reset). Any SMTP relay works
# (Resend, SendGrid, Mailgun). Unset SMTP_HOST logs mail instead of sending,
# which keeps local dev and tests working without credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=SpecAdversary <noreply@specadversary.com>
SMTP_USE_TLS=true

# OAuth (optional — leave blank to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
