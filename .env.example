OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=google/gemini-2.5-flash-lite

DATABASE_URL=postgresql://specadv:specadv@db:5432/specadv
REDIS_URL=redis://redis:6379/0
# Set only for local development when no worker service is running.
INLINE_WORKER=false
TAVILY_API_KEY=your_tavily_key_here

# Auth
JWT_SECRET=change-me-to-a-64-char-random-secret
FRONTEND_URL=http://localhost:5174
# Set ENV=production in deployment; enables strict startup validation and HSTS.
ENV=development

# Rate limiting
# Trust X-Forwarded-For for client IPs (set true only behind your own reverse proxy).
TRUST_PROXY=false
# Shared limiter storage (Redis keeps counters across restarts/replicas).
RATELIMIT_STORAGE_URI=memory://
# Per-user daily analysis allowance for authenticated users.
PER_USER_DAILY_SESSION_LIMIT=25

# OAuth (optional — leave blank to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
