# Production frontend image: static bundle behind Nginx. Dev keeps using
# Dockerfile (Vite dev server); prod compose targets this file explicitly.
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
# Baked in at build time (Vite inlines VITE_* vars): must be the public
# API origin, e.g. https://api.example.com.
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
